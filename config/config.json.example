{
    "folder_to_watch": "/srv/speech2text/audio_transfer",
    "watched_extensions": [".wav", ".mp3", ".flac", ".m4a", ".ogg"],
    "delete_after_processing": true,
    "fallback_on_failure": true,
    "transcription_log": "/srv/speech2text/speech2text.log",
    "backend": "litellm",
    "api_base": "http://litellm.intra.leivo:4000/v1",
    "ca_bundle": "/etc/ssl/certs/ca-certificates.crt",
    "model": "whisper-large-v3-turbo-local",
    "vault_secret_path": "secret/hosts/<hostname>/litellm-speech2text",
    "vault_secret_key": "litellm_api",
    "vault_service": "speech2text",
    "writable_paths": ["/srv/Obsidian/Inbox", "/srv/Obsidian/Archives/dailynotes"],
    "default_action": {
        "script_path": "handlers/general_handler.py",
        "destination": "/srv/Obsidian/Inbox"
    },
    "magic_words": {
        "NOTE": {
            "script_path": "handlers/note_handler.py",
            "destination": "/srv/Obsidian/Inbox"
        },
        "PÄIVÄKIRJA": {
            "script_path": "handlers/journal_handler.py",
            "destination": "/srv/Obsidian/Archives/dailynotes",
            "aliases": ["JOURNAL", "PÄIVÄ"]
        },
        "BLOGI": {
            "script_path": "handlers/append_handler.py",
            "destination": "/srv/Obsidian/Inbox",
            "filename": "blogi-YYYY-MM-DD.md",
            "template": "templates/blogi.md"
        },
        "GENERAL": {
            "script_path": "handlers/append_handler.py",
            "destination": "/srv/Obsidian/Inbox",
            "filename": "general.md"
        },
        "FILE": {
            "script_path": "examples/create_note.py"
        },
        "APPEND": {
            "script_path": "examples/append_log.py"
        },
        "TASK": {
            "script_path": "handlers/task_handler.py",
            "destination": "/srv/Obsidian/Inbox",
            "api_key": "<LITELLM_API_KEY>",
            "api_base": "http://litellm.intra.leivo:4000/v1",
            "model": "gpt-4o-mini",
            "aliases": ["TEHTÄVÄ"]
        }
    }
}
