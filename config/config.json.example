{
    "folder_to_watch": "/srv/speech2text/audio_transfer",
    "watched_extensions": [".wav", ".mp3", ".flac", ".m4a", ".ogg"],
    "delete_after_processing": true,
    "transcription_log": "/srv/speech2text/speech2text.log",
    "backend": "litellm",
    "model": "whisper-1",
    "vault_secret_path": "secret/hosts/<hostname>/litellm-speech2text",
    "vault_service": "speech2text",
    "writable_paths": ["/srv/Obsidian/Inbox"],
    "magic_words": {
        "NOTE": {
            "script_path": "handlers/note_handler.py"
        },
        "FILE": {
            "script_path": "examples/create_note.py"
        },
        "APPEND": {
            "script_path": "examples/append_log.py"
        }
    }
}
